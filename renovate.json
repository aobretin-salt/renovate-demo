{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "extends": [
    "config:recommended"
  ],

  "dependencyDashboard": true,

  "labels": [
    "dependencies"
  ],

  "prConcurrentLimit": 25,

  "rangeStrategy": "pin",

  "packageRules": [
    {
      "description": "Group Spring dependencies",
      "matchManagers": [
        "gradle"
      ],
      "groupName": "Spring Framework",
      "matchPackageNames": [
        "/^org\\.springframework/"
      ]
    },

    {
      "description": "Group testing dependencies",
      "matchManagers": [
        "gradle"
      ],
      "groupName": "Testing",
      "matchPackageNames": [
        "/junit/",
        "/mockito/",
        "/assertj/",
        "/testcontainers/"
      ]
    },

    {
      "description": "Automerge patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    }
  ]
}
